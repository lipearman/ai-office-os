# Database
POSTGRES_USER=aioffice
POSTGRES_PASSWORD=aioffice_secret
POSTGRES_DB=aioffice_db

# Security
SECRET_KEY=change_this_to_a_long_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379

# Environment
ENVIRONMENT=development

# LLM Providers (fill in what you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://llm-server:11434
# Default LLM when an agent's provider is "auto" (self-hosted Ollama by default)
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen2.5:7b-instruct
# Trading-desk LLM color commentary (worker calls the LLM on each heavy tick)
DESK_LLM_ENABLED=true
# Run the desk worker in the API process. Set false when running a dedicated
# worker: `python -m app.trading.worker`
RUN_WORKER_IN_PROCESS=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
